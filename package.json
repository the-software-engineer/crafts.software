{
	"name": "crafts-software",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"health:verify-vendor": "node vendor/tse-health/scripts/verify-health-vendor.mjs vendor/tse-health --manifest-sha256 f3bbeb66af0da02225ad26322252b55aa260e0d8af7d95e9424c11e1bfb8033d"
	},
	"devDependencies": {
		"@biomejs/biome": "~2.4.15",
		"@cloudflare/workers-types": "^4.20260207.0",
		"@sveltejs/adapter-cloudflare": "~7.2.8",
		"@sveltejs/kit": "~2.61.1",
		"@sveltejs/vite-plugin-svelte": "~6.2.4",
		"@types/node": "^25.2.2",
		"autoprefixer": "^10.4.20",
		"postcss": "^8.4.47",
		"svelte": "~5.55.9",
		"svelte-check": "~4.4.8",
		"tailwindcss": "^3.4.14",
		"typescript": "~5.9.3",
		"vite": "~7.3.3",
		"wrangler": "~4.94.0"
	}
}
